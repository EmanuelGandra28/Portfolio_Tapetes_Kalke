---
import '../styles/tema.css';
import config from '../../site.config.json';
const { titulo, descricao = config.fraseTopo, imagem } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const urlImagem = imagem ? new URL(imagem, Astro.site).href : undefined;
const titulocompleto = titulo ? `${titulo} · ${config.nome}` : `${config.nome} · ${config.slogan}`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulocompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#1c5c46" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.nome} />
    <meta property="og:title" content={titulocompleto} />
    <meta property="og:description" content={descricao} />
    {urlImagem && <meta property="og:image" content={urlImagem} />}
    <meta name="twitter:card" content={urlImagem ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <slot />
  </body>
</html>
